{
  "name": "pdf-text-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Upload a PDF, edit its text in place, and download the result — all in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run build && playwright test",
    "setup-ocr": "node scripts/setup-ocr.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@jsquash/jpeg": "^1.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "buffer": "^6.0.3",
    "lucide-react": "^1.26.0",
    "node-forge": "^1.4.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.8"
  }
}
